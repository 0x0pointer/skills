digraph SkillTest {
    graph [goal="Check that the differential-review skill can be loaded", model_stylesheet="* { model: gpt-5.4; reasoning_effort: low; }"]
    start [shape=Mdiamond, label="Start"]
    exit  [shape=Msquare, label="Exit"]
    probe [label="Probe", fidelity="truncate", prompt="This is a test of the tooling. Do exactly this and nothing else: 1. Call the use_skill tool with skill_name 'differential-review'. 2. List the files in .fabro/skills/differential-review/ with one shell command. Then reply with three lines: whether the use_skill tool existed and worked (yes or no, and the error if no); the first heading of the text the tool returned; the file names you listed. Do not read or change any other file."]
    start -> probe -> exit
}
