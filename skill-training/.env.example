# Copy this file to skill-training/.env and paste your key.
# skill-training/.env is git-ignored — it is never committed.
#
# With ANTHROPIC_API_KEY set, ./skill-training/sleep.sh --backend claude
# authenticates via the Anthropic API (--bare mode), so it works without a
# logged-in `claude` CLI and inside the isolated HOME.

ANTHROPIC_API_KEY=

# Optional: pin the model the sleep backend uses (default: sonnet)
# SKILLOPT_SLEEP_CLAUDE_MODEL=claude-sonnet-4-6

# ── Tools-enabled mode (sleep-tools.sh, for agentic skills) ──────────────────
# Path to your agent-smith checkout (provides the pentest-agent MCP server).
# AGENT_SMITH_DIR=/Users/gibson/Desktop/development/agent-smith
# SKILLOPT_TOOLS_MCP=0            # built-in tools only, don't load the MCP server
# SKILLOPT_TOOLS_BUILTIN=Bash,Read,Edit
# SKILLOPT_TOOLS_TIMEOUT=600      # per-rollout seconds (agentic rollouts are slow)
